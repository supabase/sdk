{
  "name": "@supabase/capability-matrix-validator",
  "version": "1.13.0",
  "private": true,
  "description": "Validator for the Supabase SDK capability matrix.",
  "type": "module",
  "scripts": {
    "validate": "bun src/cli.ts validate",
    "validate:online": "bun src/cli.ts validate --online",
    "validate-compliance": "bun src/compliance-cli.ts",
    "sync-compliance": "bun src/sync-compliance-cli.ts",
    "normalize-typedoc": "bun src/normalize-typedoc-cli.ts",
    "normalize-symbolgraph": "bun src/normalize-symbolgraph-cli.ts",
    "normalize-griffe": "bun src/normalize-griffe-cli.ts",
    "check-api-symbols": "bun src/check-api-symbols.ts",
    "coverage-mode": "bun src/coverage-mode-cli.ts",
    "check-drift": "bun src/check-drift.ts",
    "aggregate": "bun src/aggregate.ts",
    "report": "bun src/cli.ts report",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format-and-lint": "oxfmt --check . && oxlint --deny-warnings src test",
    "format-and-lint:fix": "oxfmt . && oxlint --fix src test",
    "knip": "knip",
    "build-site": "bun src/generate-site.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "ignore": "^7.0.9",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26",
    "knip": "^6.32.3",
    "oxfmt": "0.66.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "^7.0.2"
  }
}

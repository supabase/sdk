{
  "name": "@supabase/doc-generator",
  "version": "0.0.0",
  "private": true,
  "description": "Generates API docs definition files for the Supabase docs from an SDK's doc comments",
  "keywords": [
    "api-docs",
    "docs",
    "supabase"
  ],
  "homepage": "https://github.com/supabase/sdk",
  "bugs": "https://github.com/supabase/sdk/issues",
  "license": "MIT",
  "author": "Supabase",
  "repository": {
    "type": "git",
    "url": "https://github.com/supabase/sdk.git",
    "directory": "packages/doc-generator"
  },
  "bin": {
    "doc-generator": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && chmod +x dist/cli.js",
    "check-types": "tsc --noEmit",
    "format-and-lint": "oxfmt --check . && oxlint --deny-warnings src test",
    "format-and-lint:fix": "oxfmt . && oxlint --fix src test",
    "knip": "knip",
    "refresh-fixtures": "./scripts/refresh-fixtures.sh",
    "test": "bun test"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@supabase/doc-check": "link:../doc-check",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node24": "^24.0.5",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.3.0",
    "knip": "^6.32.3",
    "oxfmt": "0.66.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

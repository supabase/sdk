{
  "name": "@supabase/functions-typegen",
  "version": "0.0.0",
  "description": "Extracts the request and response contracts of Supabase Edge Functions into a language-neutral document for SDK type generators",
  "keywords": [
    "codegen",
    "deno",
    "edge-functions",
    "supabase",
    "typegen",
    "types"
  ],
  "homepage": "https://github.com/supabase/sdk",
  "bugs": "https://github.com/supabase/sdk/issues",
  "license": "MIT",
  "author": "Supabase",
  "repository": {
    "type": "git",
    "url": "https://github.com/supabase/sdk.git",
    "directory": "packages/functions-typegen"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "format-and-lint": "oxfmt --check . && oxlint --deny-warnings src test scripts",
    "format-and-lint:fix": "oxfmt . && oxlint --fix src test scripts",
    "knip": "knip",
    "test": "bun scripts/run-tests.ts test/",
    "update-expected": "bun scripts/update-expected.ts"
  },
  "dependencies": {
    "arktype": "2.2.3",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node24": "^24.0.5",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.3.0",
    "knip": "^6.32.3",
    "oxfmt": "0.66.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

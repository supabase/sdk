{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/CHANGELOG.md",
    "**/*.yml",
    "**/*.yaml",
    "**/*.toml",
    "packages/doc-check/schema/definition.schema.json",
    "packages/doc-check/test/corpus/**",
    "packages/doc-generator/test/fixtures/**"
  ],
  "overrides": [
    {
      "files": ["**/*.md"],
      "options": {
        "embeddedLanguageFormatting": "off",
        "proseWrap": "always"
      }
    }
  ]
}
